# Salin file ini jadi ".streamlit/secrets.toml" (folder yang sama, buang
# ".example" di belakang nama file), lalu isi 2 nilai di bawah dari hasil
# deploy Google Apps Script Web App kamu. JANGAN commit file
# "secrets.toml" (sudah di-gitignore) — file ".example" ini yang boleh
# di-commit sebagai contoh.
#
# Cara dapetin nilai-nilai ini: baca README.md bagian "Deploy ke Streamlit
# Community Cloud" -> "Setup Google Sheets lewat Apps Script".

gsheet_webapp_url = "https://script.google.com/macros/s/ISI_DEPLOYMENT_ID/exec"
gsheet_webapp_token = "GANTI_DENGAN_TOKEN_RAHASIA_BEBAS_KAMU_SENDIRI"
